---
import type { CollectionEntry } from "astro:content";
import type { ProtectedPost } from "../protected-posts";

interface Props {
  post: CollectionEntry<"blog"> | ProtectedPost;
}

const { post } = Astro.props;
const isProtected = "protected" in post && post.protected;
const date = new Intl.DateTimeFormat("ko-KR", {
  year: "numeric",
  month: "short",
  day: "numeric"
}).format(post.data.pubDate);
---

<article class="post-card">
  <div class="post-card__meta">
    <time datetime={post.data.pubDate.toISOString()}>{date}</time>
    {isProtected && <span class="post-card__protected">비밀글</span>}
    {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
  </div>
  <h3>
    <a href={`/posts/${post.id}/`}>{post.data.title}</a>
  </h3>
  <p>{post.data.description}</p>
  <div class="post-card__tags">
    {post.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
  </div>
</article>
