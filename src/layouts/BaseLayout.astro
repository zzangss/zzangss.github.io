---
import { getCollection } from "astro:content";
import "../styles/global.css";
import { SITE } from "../site";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
}

const {
  title,
  description = SITE.description,
  type = "website",
  publishedTime
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const posts = await getCollection("blog", ({ data }) => !data.draft);
const tagCounts = new Map<string, number>();

for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const sidebarTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "ko"))
  .slice(0, 8);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE.title} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="header-inner">
        <button class="site-menu-button" id="menu-open" type="button" aria-label="메뉴 열기" aria-controls="site-sidebar">
          <span></span><span></span><span></span>
        </button>
        <a class="wordmark" href="/" aria-label="Zzangss 기술 블로그 홈">
          Zzangss' 기술 블로그
        </a>
        <nav class="desktop-nav" aria-label="주요 메뉴">
          <a href="/posts/">글</a>
          <a href="/tags/">태그</a>
          <a href="/about/">소개</a>
        </nav>
        <a class="header-search" href="/search/" aria-label="글 검색">
          <span aria-hidden="true"></span>
          <b>검색</b>
        </a>
      </div>
    </header>

    <dialog class="site-sidebar" id="site-sidebar" aria-labelledby="sidebar-title">
      <div class="site-sidebar__inner">
        <header class="site-sidebar__header">
          <strong id="sidebar-title">Zzangss' 기술 블로그</strong>
          <button id="menu-close" type="button" aria-label="메뉴 닫기">×</button>
        </header>

        <nav class="site-sidebar__nav" aria-label="주요 메뉴">
          <a href="/"><span>전체 글</span><small>{posts.length}</small></a>
          <a href="/search/"><span>검색</span></a>
          <a href="/tags/"><span>태그</span><small>{tagCounts.size}</small></a>
          <a href="/about/"><span>소개</span></a>
        </nav>

        {sidebarTags.length > 0 && (
          <section class="site-sidebar__section">
            <h2>태그</h2>
            <div class="site-sidebar__tags">
              {sidebarTags.map(([tag, count]) => (
                <a href={`/tags/${encodeURIComponent(tag)}/`}>
                  <span>#{tag}</span><small>{count}</small>
                </a>
              ))}
            </div>
          </section>
        )}

        <div class="site-sidebar__links">
          <a href={SITE.tistory} target="_blank" rel="noreferrer">이전 블로그</a>
          <a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
    </dialog>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <p>© {new Date().getFullYear()} {SITE.author}</p>
        <div><a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a><a href="/rss.xml">RSS</a></div>
      </div>
    </footer>

    <script>
      const sidebar = document.querySelector<HTMLDialogElement>("#site-sidebar");
      const openButton = document.querySelector<HTMLButtonElement>("#menu-open");
      const closeButton = document.querySelector<HTMLButtonElement>("#menu-close");

      openButton?.addEventListener("click", () => sidebar?.showModal());
      closeButton?.addEventListener("click", () => sidebar?.close());
      sidebar?.addEventListener("click", (event) => {
        if (event.target === sidebar) sidebar.close();
      });
    </script>
  </body>
</html>
