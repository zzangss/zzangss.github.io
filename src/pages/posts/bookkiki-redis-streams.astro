---
import BaseLayout from "../../layouts/BaseLayout.astro";

const payload = {"salt":"PTIH5Z6r5CB4/1EhuUC8Og==","iv":"qpEBTuWriN9VD9JW","ciphertext":""};
---

<BaseLayout
  title="비밀번호로 보호된 게시글"
  description="비밀번호가 필요한 비공개 게시글입니다."
  noindex={true}
>
  <div
    id="protected-post"
    data-salt={payload.salt}
    data-iv={payload.iv}
    data-ciphertext={payload.ciphertext}
  >
    <section class="unlock shell" aria-labelledby="unlock-title">
      <p class="unlock__eyebrow">PRIVATE POST</p>
      <h1 id="unlock-title">비밀번호로 보호된 글입니다.</h1>
      <p>글을 열려면 전달받은 비밀번호를 입력해 주세요.</p>
      <form id="unlock-form">
        <label for="post-password">비밀번호</label>
        <div class="unlock__controls">
          <input
            id="post-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
          <button type="submit">글 열기</button>
        </div>
        <p id="unlock-status" class="unlock__status" role="alert" aria-live="polite"></p>
      </form>
    </section>
  </div>

  <script>
    const root = document.querySelector<HTMLElement>("#protected-post");
    const form = document.querySelector<HTMLFormElement>("#unlock-form");
    const input = document.querySelector<HTMLInputElement>("#post-password");
    const status = document.querySelector<HTMLElement>("#unlock-status");

    const decodeBase64 = (value: string) =>
      Uint8Array.from(atob(value), (character) => character.charCodeAt(0));

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!root || !input || !status) return;

      status.textContent = "글을 여는 중입니다.";

      try {
        const keyMaterial = await crypto.subtle.importKey(
          "raw",
          new TextEncoder().encode(input.value),
          "PBKDF2",
          false,
          ["deriveKey"]
        );
        const key = await crypto.subtle.deriveKey(
          {
            name: "PBKDF2",
            salt: decodeBase64(root.dataset.salt ?? ""),
            iterations: 310_000,
            hash: "SHA-256"
          },
          keyMaterial,
          { name: "AES-GCM", length: 256 },
          false,
          ["decrypt"]
        );
        const decrypted = await crypto.subtle.decrypt(
          {
            name: "AES-GCM",
            iv: decodeBase64(root.dataset.iv ?? "")
          },
          key,
          decodeBase64(root.dataset.ciphertext ?? "")
        );

        root.innerHTML = new TextDecoder().decode(decrypted);
        document.title = "비공개 게시글 · Zzangss' 기술 블로그";
      } catch {
        input.value = "";
        input.focus();
        status.textContent = "비밀번호가 올바르지 않습니다.";
      }
    });
  </script>
</BaseLayout>

<style>
  .unlock {
    min-height: calc(100vh - 180px);
    padding-block: clamp(80px, 14vw, 150px);
  }

  .unlock__eyebrow {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .unlock h1 {
    margin: 0;
    font-size: clamp(27px, 5vw, 42px);
    letter-spacing: -0.045em;
  }

  .unlock > p:not(.unlock__eyebrow) {
    margin: 12px 0 30px;
    color: var(--muted);
  }

  .unlock form {
    max-width: 520px;
  }

  .unlock label {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 700;
  }

  .unlock__controls {
    display: flex;
    gap: 10px;
  }

  .unlock input {
    min-width: 0;
    flex: 1;
    height: 46px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
  }

  .unlock button {
    height: 46px;
    padding: 0 20px;
    border: 0;
    border-radius: 8px;
    background: var(--accent);
    color: white;
    font-weight: 700;
    cursor: pointer;
  }

  .unlock__status {
    min-height: 1.75em;
    margin: 8px 0 0;
    color: #b42318;
    font-size: 13px;
  }

  @media (max-width: 520px) {
    .unlock__controls {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
